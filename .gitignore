# You'll be pushing to a PUBLIC repo — this file exists specifically so your
# API key never ends up there by accident. Do not remove the .env line below.
.env
.env.local
.env.*.local
.env.backup.*
node_modules/
.DS_Store

# Cross-process lockfile around store writes (src/store/state.js) — exists only transiently
# while a write is in flight; never meaningful to commit.
store/*.lock

# The agent's live memory, now a SQLite database (src/store/state.js). Binary, rewritten every
# sweep, and useless in a diff. `npm run state:export` writes the same content back out as
# plain JSON when a human or a judge wants to read it.
store/*.db
store/*.db-journal
store/state.export.json
