# You'll be pushing to a PUBLIC repo — this file exists specifically so your
# API key never ends up there by accident. Do not remove the .env line below.
.env
.env.local
.env.*.local
node_modules/
.DS_Store

# Cross-process lockfile around store/state.json writes (src/store/state.js) — exists only
# transiently while a write is in flight; never meaningful to commit.
store/state.json.lock
